{% comment %}
  Main product section.

  Renders:
  - Product gallery
  - Product information
  - Product form
  - Product benefits
{% endcomment %}

<section class="product">
    <div class="product__container">
        <div class="product__media">
            {% render 'product-gallery', product: product %}
        </div>

        <div class="product__content">
            {% render 'product-info', product: product %}

            {% render 'product-form', product: product %}
        </div>
    </div>

</section>

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'component.product.css' | asset_url | stylesheet_tag }}
{{ 'component.product-gallery.css' | asset_url | stylesheet_tag }}
{{ 'component.product-benefits.css' | asset_url | stylesheet_tag }}

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'script.product-gallery.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}